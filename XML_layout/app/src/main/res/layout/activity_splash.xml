<?xml version="1.0" encoding="utf-8"?>
<!--Container gốc-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/surface_bg"
    android:padding="24dp">

<!--biểu tượng thương hiệu-->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@android:drawable/sym_def_app_icon"
        android:scaleType="centerInside"
        android:contentDescription="Biểu tượng ứng dụng" />

<!--thông tin thương hiệu-->
    <TextView
        android:id="@+id/txtAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="ANDROID MASTER"
        android:textColor="@color/primary_blue"
        android:textSize="26sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/txtAppSlogan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Lộ trình trở thành lập trình viên di động chuyên nghiệp"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

<!--biểu thị trạng thái đang tải-->
    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="36dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/primary_blue"/>

</LinearLayout>